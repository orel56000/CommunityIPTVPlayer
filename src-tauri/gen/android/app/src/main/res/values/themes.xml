<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.community_iptv_player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Dark app background shows behind the (transparent) system bars in the
             edge-to-edge inset strips; matches the web UI background (#030712). -->
        <item name="android:windowBackground">@color/ctv_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
