{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    // Test files import with an explicit .ts extension so Node's own test
    // runner (`npm test`, no bundler involved) can resolve them. App code keeps
    // using extensionless imports, which Vite resolves.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Tests are type-checked by tsconfig.test.json, which has the node types.
  "exclude": ["src/**/*.test.ts"]
}
